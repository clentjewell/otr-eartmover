# Environment variables for the OTR Earthmover Tyre Knowledge Portal RAG.
# Copy to .env.local and fill in. Never commit .env.local to git.

# Anthropic API (for Claude completions in /api/ask)
ANTHROPIC_API_KEY=

# Cloudflare (for the rag-ingest.js script)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Resend (for transactional email if forms wired)
RESEND_API_KEY=
RESEND_FROM=tyres@jewelltyres.com.au
RESEND_TO=tyres@jewelltyres.com.au

# Site URL (for canonical, OG, sitemap generation)
NEXT_PUBLIC_SITE_URL_OTR=https://otrearthmovertyres.com
