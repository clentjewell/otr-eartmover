# Copy to .env (never commit real keys). The pipeline reads these from the
# environment; with none set it runs the offline no-model fallback.

# --- Track A: two independent vision-capable extraction models ---------------
# Use two different providers for a genuine dual pass. If only A is set, the
# run uses single-provider mode (two passes, different settings) and flags it.
EXTRACT_PROVIDER_A_KEY=
EXTRACT_PROVIDER_A_VENDOR=anthropic
EXTRACT_PROVIDER_A_MODEL=claude-opus-4-8

EXTRACT_PROVIDER_B_KEY=
EXTRACT_PROVIDER_B_VENDOR=openai
EXTRACT_PROVIDER_B_MODEL=gpt-4o

# --- Track B: embeddings -----------------------------------------------------
EMBED_PROVIDER_KEY=
EMBED_PROVIDER_VENDOR=openai
EMBED_PROVIDER_MODEL=text-embedding-3-small

# --- Run controls ------------------------------------------------------------
RASTER_DPI=200
CROP_DPI=220
MAX_COST_USD=20
COST_PER_PAGE_PASS=0.02
COST_PER_EMBED=0.00002
